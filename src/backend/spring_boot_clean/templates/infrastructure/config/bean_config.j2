package {{ ir.package }}.infrastructure.config;

{% for entity in ir.entities %}
import {{ ir.package }}.application.dto.{{ entity.name }}DtoMapper;
import {{ ir.package }}.domain.ports.I{{ entity.name }}Repository;
{% endfor %}
import {{ ir.package }}.application.usecases.*;
import org.mapstruct.factory.Mappers;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * DI wiring for use cases and their application-layer mappers.
 * Use cases are plain Java classes (no @Service), so Spring cannot discover them by itself.
 * BeanConfig is the single place that owns this wiring — change it here, not in the use cases.
 */
@Configuration
public class BeanConfig {
{% for entity in ir.entities %}

    // ── {{ entity.name }} ─────────────────────────────────────────────────────

    @Bean
    public {{ entity.name }}DtoMapper {{ entity.name | lower_first }}DtoMapper() {
        return Mappers.getMapper({{ entity.name }}DtoMapper.class);
    }

    @Bean
    public Create{{ entity.name }}UseCase create{{ entity.name }}UseCase(
            I{{ entity.name }}Repository repository,
            {{ entity.name }}DtoMapper mapper) {
        return new Create{{ entity.name }}UseCase(repository, mapper);
    }

    @Bean
    public FindById{{ entity.name }}UseCase findById{{ entity.name }}UseCase(
            I{{ entity.name }}Repository repository,
            {{ entity.name }}DtoMapper mapper) {
        return new FindById{{ entity.name }}UseCase(repository, mapper);
    }

    @Bean
    public FindAll{{ entity.name }}UseCase findAll{{ entity.name }}UseCase(
            I{{ entity.name }}Repository repository,
            {{ entity.name }}DtoMapper mapper) {
        return new FindAll{{ entity.name }}UseCase(repository, mapper);
    }

    @Bean
    public Update{{ entity.name }}UseCase update{{ entity.name }}UseCase(
            I{{ entity.name }}Repository repository,
            {{ entity.name }}DtoMapper mapper) {
        return new Update{{ entity.name }}UseCase(repository, mapper);
    }

    @Bean
    public Delete{{ entity.name }}UseCase delete{{ entity.name }}UseCase(
            I{{ entity.name }}Repository repository) {
        return new Delete{{ entity.name }}UseCase(repository);
    }
{% endfor %}
}
